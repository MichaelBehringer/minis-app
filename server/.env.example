# Vorlage fuer die Umgebungsvariablen des Backends.
#
# Lokal eine Kopie als server/.env anlegen:
#
#     cp server/.env.example server/.env
#
# Die Datei .env ist gitignored. Im Container werden dieselben Werte ueber
# docker-compose gesetzt, nicht ueber diese Datei.
#
# Fehlt eine Variable, greift der Default aus dem Quellcode - die Anwendung
# startet also auch ohne diese Datei.


# --- Datenbank ---------------------------------------------------------------
#
# Format des Treibers: benutzer:passwort@tcp(host:port)/datenbank
#
MINIS_DB_DSN=ffwadmin:passwort@tcp(127.0.0.1:3306)/minis


# --- Signaturschluessel der Anmeldung -----------------------------------------
#
# Wer diesen Schluessel kennt, kann sich als beliebiger Benutzer ausgeben.
#
# Erzeugen mit:  openssl rand -base64 48
#
# WICHTIG: der bisherige Schluessel stand im Quellcode und steht damit dauerhaft
# in der Git-Historie. Er MUSS auf der Produktivmaschine durch einen neuen
# ersetzt werden, sonst ist die Verlagerung hierher wirkungslos.
#
# Ein Wechsel macht alle ausgegebenen Tokens ungueltig, alle muessen sich einmal
# neu anmelden. Das sollte ohnehin einmal passieren, weil die bisherigen Tokens
# kein Ablaufdatum hatten.
#
MINIS_JWT_SECRET=bitte-aendern


# --- Adresse, auf der der Server lauscht --------------------------------------
#
# Lokal reicht localhost. Im Container muss es :8080 sein, sonst ist der Dienst
# von aussen nicht erreichbar - das war bisher die Zeile, die vor jedem Deployen
# von Hand geaendert wurde.
#
# MINIS_LISTEN_ADDR=localhost:8080
