# Vorlage fuer die Zugangsdaten der Produktivumgebung.
#
# Auf der VM eine Kopie als .env neben der docker-compose.yml anlegen:
#
#     cp .env.example .env && nano .env
#
# Die Datei .env ist gitignored. Docker Compose liest sie automatisch und setzt
# die Werte in docker-compose.yml ein. Fehlt ein Wert, bricht
# "docker compose up" mit einer Meldung ab - es wird nichts stillschweigend mit
# einem Default gestartet, der auf die falsche Datenbank zeigen koennte.


# --- Datenbank ---------------------------------------------------------------
#
# Format des Treibers: benutzer:passwort@tcp(host:port)/datenbank
#
# WICHTIG: der bisherige Zugang stand im Quellcode und steht damit dauerhaft in
# der Git-Historie. Das Passwort MUSS gewechselt werden, sonst ist die
# Verlagerung hierher wirkungslos.
#
# Laeuft die Datenbank spaeter auf der VM selbst, statt extern:
#   1. host.docker.internal als Host eintragen (der Eintrag extra_hosts in der
#      docker-compose.yml sorgt dafuer, dass der Name aufloest).
#   2. MySQL muss auf der Docker-Bridge lauschen, nicht nur auf 127.0.0.1.
#   3. Der Benutzer muss von der Docker-Subnetz-Adresse zugelassen sein.
#   4. Die Firewall muss den Container durchlassen - siehe README.
#
MINIS_DB_DSN=benutzer:passwort@tcp(host:3306)/minis


# --- Signaturschluessel der Anmeldung -----------------------------------------
#
# Wer diesen Schluessel kennt, kann sich als beliebiger Benutzer ausgeben.
#
# Erzeugen mit:  openssl rand -base64 48
#
# WICHTIG: auch der bisherige Schluessel stand im Quellcode. Er MUSS gewechselt
# werden.
#
# Ein Wechsel macht alle ausgegebenen Tokens ungueltig, alle muessen sich einmal
# neu anmelden. Das sollte ohnehin einmal passieren, weil die bisherigen Tokens
# kein Ablaufdatum hatten und damit unbegrenzt galten.
#
MINIS_JWT_SECRET=bitte-aendern
